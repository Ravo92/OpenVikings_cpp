diff --git a/src/io/Style.c b/src/io/Style.c
index a607898..e48bffb 100644
--- a/src/io/Style.c
+++ b/src/io/Style.c
@@ -275,3 +275,46 @@ DmResult DmStyle_parse(DmStyle* slf, void* buf, size_t len) {
 
 	return DmResult_SUCCESS;
 }
+
+// OpenVikings: SDK RIFF DMPT contains parts inside its single pttn list.
+DmResult DmStyle_parsePatternTrack(DmStyle* slf, DmRiff* source) {
+	void* backing = Dm_alloc((size_t) source->len + 12);
+	if (backing == NULL) return DmResult_MEMORY_EXHAUSTED;
+	uint32_t header[3] = {DM_FOURCC_RIFF, source->len + 4, DM_FOURCC('D','M','P','T')};
+	memcpy(backing, header, 12);
+	memcpy((uint8_t*) backing + 12, source->mem, source->len);
+	slf->backing_memory = backing;
+	DmRiff rif;
+	if (!DmRiff_init(&rif, backing, (size_t) source->len + 12)) return DmResult_FILE_CORRUPT;
+	DmRiff cnk;
+	while (DmRiff_readChunk(&rif, &cnk)) {
+		if (DmRiff_is(&cnk, DM_FOURCC_STYH, 0)) {
+			DmTimeSignature_parse(&slf->time_signature, &cnk);
+			DmRiff_readDouble(&cnk, &slf->tempo);
+		} else if (DmRiff_is(&cnk, DM_FOURCC_LIST, DM_FOURCC_PTTN)) {
+			DmRiff scan = cnk, child;
+			while (DmRiff_readChunk(&scan, &child)) {
+				if (DmRiff_is(&child, DM_FOURCC_LIST, DM_FOURCC_PART)) {
+					DmPart part;
+					DmPart_init(&part);
+					DmResult rv = DmStyle_parsePart(&part, &child);
+					if (rv == DmResult_SUCCESS) rv = DmPartList_add(&slf->parts, part);
+					if (rv != DmResult_SUCCESS) { DmPart_free(&part); return rv; }
+				} else if (DmRiff_is(&child, DM_FOURCC_RIFF, DM_FOURCC_DMBD)) {
+					DmBand* band = NULL;
+					DmResult rv = DmBand_create(&band);
+					if (rv == DmResult_SUCCESS) rv = DmBand_parse(band, &child);
+					if (rv == DmResult_SUCCESS) rv = DmBandList_add(&slf->bands, band);
+					if (rv != DmResult_SUCCESS) { DmBand_release(band); return rv; }
+				}
+			}
+			DmPattern pattern;
+			DmPattern_init(&pattern);
+			DmResult rv = DmStyle_parsePattern(&pattern, &cnk);
+			if (rv == DmResult_SUCCESS && (pattern.length_measures == 0 || pattern.time_signature.beat == 0 || pattern.time_signature.beats_per_measure == 0 || pattern.time_signature.grids_per_beat == 0)) rv = DmResult_FILE_CORRUPT;
+			if (rv == DmResult_SUCCESS) rv = DmPatternList_add(&slf->patterns, pattern);
+			if (rv != DmResult_SUCCESS) { DmPattern_free(&pattern); return rv; }
+		}
+	}
+	return slf->patterns.length == 1 ? DmResult_SUCCESS : DmResult_FILE_CORRUPT;
+}
