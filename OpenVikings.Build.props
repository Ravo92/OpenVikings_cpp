<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="OpenVikings.Dependencies.props" />
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)OpenVikings\$(Configuration)\</OutDir>
    <OutDir Condition="'$(Platform)'=='x64'">$(MSBuildThisFileDirectory)OpenVikings\$(Configuration)\x64\</OutDir>
    <IntDir>$(OutDir)obj\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <FloatingPointModel>Precise</FloatingPointModel>
      <EnableEnhancedInstructionSet Condition="'$(Platform)'=='Win32'">StreamingSIMDExtensions2</EnableEnhancedInstructionSet>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ProgramDataBaseFileName>$(OutDir)symbols\$(TargetName).compiler.pdb</ProgramDataBaseFileName>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <SupportJustMyCode>false</SupportJustMyCode>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
  </ItemDefinitionGroup>
  <PropertyGroup Condition="'$(ConfigurationType)'=='Application'">
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerWorkingDirectory Condition="'$(LocalDebuggerWorkingDirectory)'==''">$(ProjectDir)</LocalDebuggerWorkingDirectory>
    <!-- Retain CRT diagnostics without the debugger's additional Windows heap checks. -->
    <OpenVikingsEnableWindowsDebugHeap Condition="'$(OpenVikingsEnableWindowsDebugHeap)'==''">false</OpenVikingsEnableWindowsDebugHeap>
    <LocalDebuggerEnvironment Condition="'$(OpenVikingsEnableWindowsDebugHeap)'!='true'">$(LocalDebuggerEnvironment)&#xA;_NO_DEBUG_HEAP=1</LocalDebuggerEnvironment>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(ConfigurationType)'=='Application'">
    <Link>
      <SubSystem>Windows</SubSystem>
      <TargetMachine Condition="'$(Platform)'=='Win32'">MachineX86</TargetMachine>
      <TargetMachine Condition="'$(Platform)'=='x64'">MachineX64</TargetMachine>
      <ProgramDatabaseFile>$(OutDir)symbols\$(TargetName).pdb</ProgramDatabaseFile>
      <IncrementalLinkDatabaseFile>$(IntDir)$(TargetName).ilk</IncrementalLinkDatabaseFile>
      <AdditionalDependencies>msacm32.lib;dwrite.lib;gdi32.lib;d3d11.lib;dxgi.lib;d3dcompiler.lib;ddraw.lib;winmm.lib;dsound.lib;dxguid.lib;ole32.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Keep all original translation units, including registration and initialization objects. -->
      <AdditionalOptions>/WHOLEARCHIVE:"$(OutDir)OpenVikingsEngine.lib" %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(ConfigurationType)'=='Application' and '$(Configuration)'=='Release'">
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>false</EnableCOMDATFolding>
      <GenerateDebugInformation>DebugFull</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="CreateBuildSymbolsDirectory" BeforeTargets="ClCompile;Lib;Link">
    <MakeDir Directories="$(OutDir)symbols" />
  </Target>
  <Target Name="CopyRemasterAssetPack" AfterTargets="Build" Condition="'$(ConfigurationType)'=='Application' and Exists('$(MSBuildThisFileDirectory)assets\remaster\remaster.lib')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)assets\remaster\remaster.lib" DestinationFiles="$(OutDir)remaster.lib" SkipUnchangedFiles="true" />
  </Target>
</Project>
